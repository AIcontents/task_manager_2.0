# Образец переменных окружения для docker compose.
#   cp .env.example .env     и замените значения.
# Файл .env в Git НЕ коммитится (он в .gitignore): там реальные пароли.

POSTGRES_DB=taskdb
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=change_me

# Секрет подписи JWT: не короче 32 символов. Сгенерировать: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars

# Тестовый администратор (создаётся при старте приложения)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_too
