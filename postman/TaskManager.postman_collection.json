{
  "info": {
    "name": "Task Manager API",
    "description": "Запросы ко всем частям проекта. Порядок: 1. Auth -> 2. Tasks -> 3. ADMIN. Токены сохраняются в переменные коллекции скриптами. Префиксы /tasks и /api/tasks равнозначны.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userEmail",
      "value": "postman-user@example.com"
    },
    {
      "key": "userPassword",
      "value": "password123"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": "admin12345"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Регистрация USER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", json.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", json.refreshToken);",
                  "pm.test(\"В ответе есть accessToken и refreshToken\", function () { pm.expect(json.accessToken).to.be.a(\"string\").and.not.empty; pm.expect(json.refreshToken).to.be.a(\"string\").and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Создаёт пользователя с ролью USER и сохраняет токены в переменные коллекции. Повторный запуск вернёт 409."
          }
        },
        {
          "name": "Вход USER (login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", json.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", json.refreshToken);",
                  "pm.test(\"В ответе есть accessToken и refreshToken\", function () { pm.expect(json.accessToken).to.be.a(\"string\").and.not.empty; pm.expect(json.refreshToken).to.be.a(\"string\").and.not.empty; });"
                ]
